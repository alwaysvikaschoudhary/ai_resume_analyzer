# ============================================================================
# AI Resume Analyzer — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] have no safe default — the app won't work
# correctly without them.  All others fall back to the defaults shown.
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION SERVER
# ----------------------------------------------------------------------------
APP_PORT=8080                              # host-side port (Docker only)

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL + pgvector)
# ----------------------------------------------------------------------------
DB_NAME=resume_analyzer
DB_USERNAME=postgres
DB_PASSWORD=postgres                       # [REQUIRED] change in production
DB_PORT=5432                               # host-side port exposed by Docker

# ----------------------------------------------------------------------------
# LLM STUDIO (OpenAI-compatible endpoint)
# ----------------------------------------------------------------------------
LLM_STUDIO_BASE_URL=http://localhost:1234
LLM_STUDIO_API_KEY=sk-lm-your-key-here    # [REQUIRED] your LLM Studio API key
LLM_STUDIO_MODEL=mistralai/mistral-7b-instruct-v0.3
LLM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ----------------------------------------------------------------------------
# JWT / AUTHENTICATION
# ----------------------------------------------------------------------------
# Must be ≥ 256 bits (32+ chars) for HS256.  Generate one with:
#   openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_256_BIT_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=900000         # 15 minutes  (ms)
JWT_REFRESH_TOKEN_EXPIRATION=604800000     # 7 days      (ms)
JWT_SSE_TOKEN_EXPIRATION=60000             # 60 seconds  (ms)
