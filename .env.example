# ============================================================================
# AI Resume Analyzer — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] have no safe default — the app won't work
# correctly without them.  All others fall back to the defaults shown.
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION SERVER
# ----------------------------------------------------------------------------
APP_PORT=8080                              # host-side port (Docker only)

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL + pgvector)
# ----------------------------------------------------------------------------
DB_NAME=resume_analyzer
DB_USERNAME=postgres
DB_PASSWORD=postgres                       # [REQUIRED] change in production
DB_PORT=5432                               # host-side port exposed by Docker

# ----------------------------------------------------------------------------
# LLM STUDIO (OpenAI-compatible endpoint)
# ----------------------------------------------------------------------------
LLM_STUDIO_BASE_URL=http://localhost:1234
LLM_STUDIO_API_KEY=sk-lm-your-key-here    # [REQUIRED] your LLM Studio API key
LLM_STUDIO_MODEL=mistralai/mistral-7b-instruct-v0.3
LLM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ----------------------------------------------------------------------------
# JWT / AUTHENTICATION
# ----------------------------------------------------------------------------
# Must be ≥ 256 bits (32+ chars) for HS256.  Generate one with:
#   openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_256_BIT_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=900000         # 15 minutes  (ms)
JWT_REFRESH_TOKEN_EXPIRATION=604800000     # 7 days      (ms)
JWT_SSE_TOKEN_EXPIRATION=60000             # 60 seconds  (ms)

# ----------------------------------------------------------------------------
# FILE UPLOADS
# ----------------------------------------------------------------------------
UPLOAD_DIR=./uploads                       # path on host (or /app/uploads in Docker)

# ----------------------------------------------------------------------------
# EXTERNAL ENRICHMENT APIs  (all optional — leave blank to disable)
# ----------------------------------------------------------------------------
GITHUB_API_TOKEN=                          # GitHub PAT — raises rate limit to 5 000 req/hr
TWITTER_BEARER_TOKEN=                      # Twitter/X bearer token (developer.twitter.com)
TAVILY_API_KEY=                            # Tavily web-search key (app.tavily.com)

# Enrichment tuning
ENRICHMENT_STALENESS_TTL=7                 # days before a profile is considered stale
ENRICHMENT_SOURCE_SELECTION=false          # extra LLM call to pick relevant sources
ENRICHMENT_MULTI_PASS=true                 # re-match borderline candidates after enrichment

# ----------------------------------------------------------------------------
# PEKKO (Actor-based resume processing pipeline)
# ----------------------------------------------------------------------------
PEKKO_ENABLED=true
PEKKO_WORKERS=5                            # parallel worker actors
PEKKO_POLL_INTERVAL=5000                   # ms between job-queue polls
PEKKO_INITIAL_DELAY=10000                  # ms before first poll after startup
PEKKO_CLAIM_BATCH=5                        # max jobs claimed per poll
PEKKO_MAILBOX_CAPACITY=100                 # backpressure bound
PEKKO_WORKER_ID=worker-1                   # unique per instance in a cluster
PEKKO_STALE_THRESHOLD=15                   # minutes without heartbeat = stale
PEKKO_STALE_CHECK_INTERVAL=60000           # ms between stale-job sweeps
PEKKO_CLEANUP_CRON=0 0 2 * * ?             # cron: purge old jobs daily at 2 AM
PEKKO_CLEANUP_RETENTION=30                 # days to keep completed jobs
PEKKO_METRICS_INTERVAL=300000              # ms between metrics log entries
